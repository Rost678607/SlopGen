# Copy to .env and fill in what you use. Loaded automatically at startup.

# LLM — only the key for the provider chosen in configs/slopgen.toml [llm] is needed.
# Gemini and OpenRouter have free tiers — good for testing without a paid key.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY= # for provider = "custom"

# Stock footage (both free; optional if you use assets/footage instead)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI-generated footage (free): use the ai_photo / ai_video visuals sources.
# Both tokens are OPTIONAL — Pollinations and HF Spaces work without a key.
# HF_TOKEN shortens Hugging Face Space queues for `wan` video.
# POLLINATIONS_TOKEN unlocks higher image rate limits / tier.
# Either may hold SEVERAL keys, comma- or newline-separated: an AI-drama
# orchestration stage rotates through them as each hits its daily limit.
HF_TOKEN=
POLLINATIONS_TOKEN=

# Voice engines. Neither is needed for the default `edge` engine, which has no key
# at all; set the one for whichever engine [tts].engine names.
# Azure Speech — the paid catalogue behind edge-tts (700+ voices, Dragon HD Omni).
# AZURE_SPEECH_REGION overrides [tts.azure].region; the HD voices are preview-only
# and exist in eastus / westeurope / swedencentral / southeastasia.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Alibaba DashScope (Qwen3-TTS) — cheaper, and clones a voice from your sample.
# Mint the key on the INTERNATIONAL console: a mainland key is rejected here.
DASHSCOPE_API_KEY=
