[paths]
assets = "assets"
output = "output"
state = "state"

[video]
width = 1080
height = 1920
fps = 30
target_duration_s = 45.0

[subtitles]
style = "word_pop"
font = "DejaVu Sans"
font_size = 110
primary_color = "&H00FFFFFF"
accent_color = "&H0000D7FF"
outline = 8

[audio]
music_volume = 0.12

# Words edge-tts says wrong, and the spelling that makes it say them right. Only
# needed where no rule could help: a Cyrillic acronym is read as a word whenever its
# letters form a pronounceable syllable — correct for «ВУЗ», wrong for «НЛО». The
# subtitles keep the original spelling either way.
#
# Separate the parts with SPACES. Hyphens do not work: measured in running speech,
# «эн-эл-о» takes 0.26s — exactly as long as the broken «НЛО» — because the
# normalizer collapses a hyphenated run back into one syllable, while the spaced
# «эн эл о» takes 0.62s and is genuinely spelled out. Whether bare letters or their
# phonetic names read better varies by word (for «НЛО» the names are twice as quick),
# so try both and keep what sounds right.
[tts.pronounce.ru]
"НЛО" = "эн эл о"
"ВОЗ" = "В О З"

[llm]
profile = "deepseek"

[ui]
lang = "ru"
theme = "minecraft"

[footage]
providers = [
    "pexels",
    "pixabay",
    "local",
]
# Video generators are picked per visuals profile / drama orchestration, not here.
# Besides the free AI backends (auto | wan2.1 | ltx-video | animatediff) there is
# a user-assisted backend: ai_model / model = "manual". With it slopgen writes one
# prompt per shot and you generate each clip by hand in an external web tool
# (Kling / Veo-Flow / Pika), then hand the files back — the run pauses at the
# footage stage and you fill clips with `slopgen gather` (or by dropping
# shot_NN.mp4 into the run's manual/inbox/). See configs/visuals/ai_manual.toml
# and configs/orchestration/manual.toml.

[defaults]
count = 1
ad_mode = "both"
