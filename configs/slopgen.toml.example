[paths]
assets = "assets"
output = "output"
state = "state"
# Downloaded neural weights (`slopgen models`). Gitignored like the three above:
# the local voice alone is 2.3 GiB, so it is fetched rather than shipped.
models = "models"

[video]
width = 1080
height = 1920
fps = 30
target_duration_s = 45.0

[subtitles]
style = "word_pop"
font = "DejaVu Sans"
font_size = 110
primary_color = "&H00FFFFFF"
accent_color = "&H0000D7FF"
outline = 8

[audio]
music_volume = 0.12

# Words edge-tts says wrong, and the spelling that makes it say them right. Only
# needed where no rule could help: a Cyrillic acronym is read as a word whenever its
# letters form a pronounceable syllable — correct for «ВУЗ», wrong for «НЛО». The
# subtitles keep the original spelling either way.
#
# Separate the parts with SPACES. Hyphens do not work: measured in running speech,
# «эн-эл-о» takes 0.26s — exactly as long as the broken «НЛО» — because the
# normalizer collapses a hyphenated run back into one syllable, while the spaced
# «эн эл о» takes 0.62s and is genuinely spelled out. Whether bare letters or their
# phonetic names read better varies by word (for «НЛО» the names are twice as quick),
# so try both and keep what sounds right.
# Who speaks. `edge` is free, needs no key, and reports word timings itself, which
# is what the subtitles are built on — it is the default for both reasons.
#
#   edge        free, no key, 2 Russian voices + 12 multilingual, word timings included
#   azure       the same synthesizer's paid catalogue: 700+ voices incl. Dragon HD Omni,
#               also with word timings. ~$22/1M characters. Needs AZURE_SPEECH_KEY.
#   qwen        Alibaba DashScope: cheaper (~$13/1M, first million free for 90 days)
#               and clones a voice from your sample. Needs DASHSCOPE_API_KEY.
#   qwen-local  the same cloning offline and free, at ~5 minutes of CPU per minute of
#               speech. Needs `slopgen models install qwen3-tts-0.6b` (2.3 GiB).
#
# The last two report NO word timings, so they need a recognizer to read the timings
# back off the audio: `slopgen models install vosk-ru-small`. Install it first — the
# run refuses to start without it rather than voicing an hour of untimed narration.
[tts]
engine = "edge"

# A cloning run listens to its own reference before it voices anything, and when the
# sample scores badly it voices ONE short line to find out whether that matters —
# refusing only if the model will not say it. The score alone never refuses: a
# recognizer that cannot make out a child or a whisper scores a good sample badly.
# Turning this off skips both, and trouble then shows up an hour into a render.
check_reference = true

# Preview-region only, and the Dragon HD Omni voices simply do not exist elsewhere:
# eastus | westeurope | swedencentral | southeastasia
[tts.azure]
region = "eastus"
temperature = 1.0
enhance_pronunciation = true

[tts.qwen]
# the international endpoint; a key minted here is rejected by the mainland host
base_url = "https://dashscope-intl.aliyuncs.com/api/v1"
model = "qwen3-tts-flash"

# Both measured on a Ryzen 7840U: bfloat16 with one thread per PHYSICAL core ran 3.3x
# faster than float32 with one per hardware thread. `threads = 0` counts the cores.
[tts.qwen_local]
model_id = "qwen3-tts-0.6b"
dtype = "bfloat16"
threads = 0

# One recognizer per content language, by id from the model catalogue.
[tts.align.models]
ru = "vosk-ru-small"
en = "vosk-en-small"

[tts.pronounce.ru]
"НЛО" = "эн эл о"
"ВОЗ" = "В О З"

[llm]
profile = "deepseek"

[ui]
lang = "ru"
theme = "minecraft"

[footage]
providers = [
    "pexels",
    "pixabay",
    "local",
]
# Video generators are picked per visuals profile / drama orchestration, not here.
# Besides the free AI backends (auto | wan2.1 | ltx-video | animatediff) there is
# a user-assisted backend: ai_model / model = "manual". With it slopgen writes one
# prompt per shot and you generate each clip by hand in an external web tool
# (Kling / Veo-Flow / Pika), then hand the files back — the run pauses at the
# footage stage and you fill clips with `slopgen gather` (or by dropping
# shot_NN.mp4 into the run's manual/inbox/). See configs/visuals/ai_manual.toml
# and configs/orchestration/manual.toml.

[defaults]
count = 1
ad_mode = "both"
