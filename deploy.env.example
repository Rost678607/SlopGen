# Скопируй в deploy.env и заполни. deploy.env НЕ коммитится (там адрес сервера).
# Copy to deploy.env and fill it in. deploy.env is gitignored — it names your box.

SSH_HOST=slopbox.local       # IP, DNS/mDNS-имя или алиас из ~/.ssh/config
SSH_USER=rostik              # sudo-пользователь на сервере (под ним ходят ssh/rsync)

# Ниже можно ничего не трогать — значения совпадают с deploy/slopgen-bot.service.
# Everything below matches the unit file; leave it alone unless you change that too.

# SERVICE_USER=slopgen       # системный юзер сервиса (заводится при bootstrap)
# REMOTE_ROOT=/opt/slopgen   # внутри: current -> .releases/<стамп>/, .state/, .venv/
# UNIT=slopgen-bot           # имя systemd-юнита

# Что уезжает на сервер вместе с кодом при первом заходе (`seed`). Дальше это
# СЕРВЕРНОЕ состояние: `push` его не трогает, чтобы выкат не затирал живые настройки.
# SEED="configs .env assets"

# Ставить ли cloudflared при bootstrap. Без него чат работает, а кнопки
# мини-приложения нет: Telegram открывает только https.
# WANT_CLOUDFLARED=1
