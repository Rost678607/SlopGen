# --- Python / build ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# --- Secrets & runtime output ---
.env
# The deploy target: it names your server, which is nobody else's business.
deploy.env
secrets/
output/
state/
# Downloaded neural weights (see `slopgen models`). The local voice alone is 2.3 GiB;
# nothing here is ever committed — the catalogue in src/slopgen/models/registry.py is.
# Anchored to the repo root on purpose: a bare `models/` would also swallow the
# source package of that same name.
/models/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Private / bring-your-own content (not shipped) ---
# The active user config is personal (LLM profile, language, keys). Ship the
# template instead; users copy it to configs/slopgen.toml and edit locally.
configs/slopgen.toml
!configs/slopgen.toml.example
# Who the Telegram bot talks to. A list of real people's account ids — personal in
# the same way the voices are, and the bot writes the file itself on first start.
configs/bot_allow.txt
# Personal LLM connection profiles; the three provider presets ship as examples.
configs/llm/*.toml
!configs/llm/deepseek.toml
!configs/llm/gemini.toml
!configs/llm/openrouter.toml
# Cloned voices: a card plus a recording of somebody actually speaking. Both are
# personal in a way a config normally is not — this is a real person's voice — so the
# whole folder stays out of the repository, samples included.
configs/voices/*
!configs/voices/.gitkeep
# Personal content types. The four shipped niches are the documentation of what a
# niche brief looks like; anything else in here is the operator's own editorial line,
# and a brief is where that line is spelled out in full — including the parts of it
# that have no business on a public remote.
configs/content/*.toml
!configs/content/cyber.toml
!configs/content/facts.toml
!configs/content/psych.toml
!configs/content/story.toml
# The chat mode's people and its presets. A persona is somebody real as often as not —
# their nickname, their picture, their voice — and a preset is the operator's own
# editorial line about what their videos are. Both belong beside the cast, which is to
# say out of the repository.
configs/personas/*.toml
!configs/personas/example.toml
configs/chat/*.toml
!configs/chat/example.toml
# Personal AI-drama cast, publishing accounts, and ad contracts.
configs/characters/*.toml
!configs/characters/example.toml
configs/accounts/*.toml
configs/ads/*.toml
!configs/ads/example_vpn.toml
# Personal fandoms — a world is a folder of lore, its own cast and a compiled canon
# sheet. The shipped "example" world doubles as the documentation of what good lore
# looks like, so it stays.
configs/fandoms/*
!configs/fandoms/example/
!configs/fandoms/example/**
# …but never the frame base's PICTURES. The example world documents what a card
# looks like, which is a TOML file; the stills a run delivers into it are the
# operator's own material and several megabytes each.
configs/fandoms/example/frames/*.png
configs/fandoms/example/frames/*.jpg
configs/fandoms/example/frames/*.jpeg
configs/fandoms/example/frames/*.webp
configs/fandoms/example/frames/*.mp4

# The effects base. The two shipped examples are the documentation of what an effect
# IS — a ring and an arrow, both generated by ffmpeg, both tiny — and everything else
# in there is somebody's own material: bought sound packs, whole clips, a sting the
# operator recorded. Same shape as the fandoms above: ignore the folder, keep the
# examples and the two files they are made of.
configs/effects/*
!configs/effects/ring.toml
!configs/effects/ring.png
!configs/effects/arrow.toml
!configs/effects/arrow.png

# The voice filters: what one LINE is heard through (see src/slopgen/media/voicefx.py).
# The six shipped cards are the documentation of what a filter IS, and they are cheap
# to ship because every background they use is generated by ffmpeg out of an
# expression — there is no audio beside them to commit. Everything else in the folder
# is the operator's own: their filters, and the loops a card may name instead of a
# generated one, which are a bought sound pack as often as not.
configs/voicefx/*
!configs/voicefx/tape.toml
!configs/voicefx/phone.toml
!configs/voicefx/radio.toml
!configs/voicefx/megaphone.toml
!configs/voicefx/vinyl.toml
!configs/voicefx/memory.toml

# Typefaces are licensed material too, and the ones a run actually wants are named
# in the config rather than carried here (see src/slopgen/typeface.py). The folder
# exists so there is somewhere obvious to put them: anything in it is found by name,
# on any platform, before the system's own fonts.
assets/fonts/*
!assets/fonts/.gitkeep

# Media libraries are copyright-sensitive — supply your own.
assets/music/*
!assets/music/.gitkeep
assets/footage/*
!assets/footage/.gitkeep
# The chat mode's four, and all of them are somebody's own material: faces, a
# wallpaper, a notification sound, and exports of real conversations — the last being
# the most personal thing in the repository after a cloned voice.
assets/avatars/*
!assets/avatars/.gitkeep
assets/chat_bg/*
!assets/chat_bg/.gitkeep
assets/chat_sfx/*
!assets/chat_sfx/.gitkeep
assets/exports/*
!assets/exports/.gitkeep
assets/ads/*
!assets/ads/.gitkeep
!assets/ads/example_vpn/
!assets/ads/example_vpn/**

# The private ffmpeg the wrapper fetches when the system has none (scripts/bootstrap.py).
.tools/
