# --- Python / build ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# --- Secrets & runtime output ---
.env
# The deploy target: it names your server, which is nobody else's business.
deploy.env
secrets/
output/
state/
# Downloaded neural weights (see `slopgen models`). The local voice alone is 2.3 GiB;
# nothing here is ever committed — the catalogue in src/slopgen/models/registry.py is.
# Anchored to the repo root on purpose: a bare `models/` would also swallow the
# source package of that same name.
/models/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Private / bring-your-own content (not shipped) ---
# The active user config is personal (LLM profile, language, keys). Ship the
# template instead; users copy it to configs/slopgen.toml and edit locally.
configs/slopgen.toml
!configs/slopgen.toml.example
# Who the Telegram bot talks to. A list of real people's account ids — personal in
# the same way the voices are, and the bot writes the file itself on first start.
configs/bot_allow.txt
# Personal LLM connection profiles; the three provider presets ship as examples.
configs/llm/*.toml
!configs/llm/deepseek.toml
!configs/llm/gemini.toml
!configs/llm/openrouter.toml
# Cloned voices: a card plus a recording of somebody actually speaking. Both are
# personal in a way a config normally is not — this is a real person's voice — so the
# whole folder stays out of the repository, samples included.
configs/voices/*
!configs/voices/.gitkeep
# Personal AI-drama cast, publishing accounts, and ad contracts.
configs/characters/*.toml
!configs/characters/example.toml
configs/accounts/*.toml
configs/ads/*.toml
!configs/ads/example_vpn.toml
# Personal fandoms — a world is a folder of lore, its own cast and a compiled canon
# sheet. The shipped "example" world doubles as the documentation of what good lore
# looks like, so it stays.
configs/fandoms/*
!configs/fandoms/example/
!configs/fandoms/example/**
# …but never the frame base's PICTURES. The example world documents what a card
# looks like, which is a TOML file; the stills a run delivers into it are the
# operator's own material and several megabytes each.
configs/fandoms/example/frames/*.png
configs/fandoms/example/frames/*.jpg
configs/fandoms/example/frames/*.jpeg
configs/fandoms/example/frames/*.webp
configs/fandoms/example/frames/*.mp4

# Media libraries are copyright-sensitive — supply your own.
assets/music/*
!assets/music/.gitkeep
assets/footage/*
!assets/footage/.gitkeep
assets/ads/*
!assets/ads/.gitkeep
!assets/ads/example_vpn/
!assets/ads/example_vpn/**
